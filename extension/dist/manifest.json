{
  "manifest_version": 3,
  "name": "Wordle Entropy Solver",
  "version": "1.1.0",
  "description": "An autonomous AI-powered Wordle solver using Shannon Entropy and Groq LLM fallback. Supports NYT Wordle, Wordle Unlimited, Hello Wordl, Quordle, Octordle, Dordle, Sedecordle, Hurdle, Absurdle, Evil Wordle, Kilordle, and Lingle.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.nytimes.com/*",
    "https://*.wordleunlimited.org/*",
    "https://wordleunlimited.org/*",
    "https://*.hellowordl.net/*",
    "https://*.quordle.com/*",
    "https://*.merriam-webster.com/*",
    "https://*.octordle.com/*",
    "https://*.dordle.io/*",
    "https://*.sedecordle.com/*",
    "https://*.arkadium.com/*",
    "https://*.qntm.org/*",
    "https://*.github.io/*",
    "https://*.kilordle.com/*",
    "https://*.lingle.today/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/wordle/*",
        "https://*.wordleunlimited.org/*",
        "https://wordleunlimited.org/*",
        "https://*.hellowordl.net/*",
        "https://*.quordle.com/*",
        "https://*.merriam-webster.com/games/quordle*",
        "https://*.octordle.com/*",
        "https://*.dordle.io/*",
        "https://*.sedecordle.com/*",
        "https://*.arkadium.com/games/hurdle*",
        "https://*.qntm.org/files/absurdle/*",
        "https://*.swag.github.io/evil-wordle/*",
        "https://*.kilordle.com/*",
        "https://*.lingle.today/*",
        "https://*.vercel.app/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
